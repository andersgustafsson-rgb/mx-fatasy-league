# MX Fantasy League - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///fantasy_mx_local.db
# For local sync from Render (hamta_prod_data.bat) — External Database URL from Render Postgres:
# PRODUCTION_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# For PostgreSQL: postgresql://username:password@localhost:5432/mx_fantasy
# For MySQL: mysql://username:password@localhost:3306/mx_fantasy

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Public URL for password-reset and other email links (use your real https URL in production).
# On Render you can set this explicitly, or rely on RENDER_EXTERNAL_URL which Render provides.
# Example (Frankfurt/EU): https://mx-fatasy-league.eu.onrender.com
PUBLIC_BASE_URL=

# Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Sätt till 1 på Render tillfälligt om /admin/api/social-recap.png ger 500 — då får JSON-felet
# med full traceback i Race Recap Studio (statusrad) och i Render-loggen (social_recap_png failed).
# ADMIN_API_TRACEBACK=1

# Email Configuration (Gmail SMTP)
# To use Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character App Password (with spaces removed) as GMAIL_PASSWORD
GMAIL_USER=spliffan78@gmail.com
GMAIL_PASSWORD=your-gmail-app-password-here
GMAIL_FROM_NAME=MX Fantasy League

# Pit Lane e-post (DM + Race Control). Sätt PIT_LANE_EMAIL_NOTIFY=0 för att stänga av.
# PIT_LANE_EMAIL_NOTIFY=1

# Web Push — duell-notiser (test). Generera med: python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=  (Application Server Key, en rad)
# VAPID_PRIVATE_KEY=  (PEM med \n för radbrytningar)
# VAPID_SUBJECT=mailto:din@email.se

# Schemalagda push-påminnelser (Kundmail). Render Cron: POST /api/cron/reminders varje minut.
# Header: Authorization: Bearer <CRON_SECRET>  eller  X-Cron-Secret: <CRON_SECRET>
# CRON_SECRET=generate-a-long-random-string
# FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=61586769893903
FACEBOOK_PAGE_URL=
# Timeline embed on homepage footer is ON by default (facebook.com/plugins). Set to 0 to disable.
# FACEBOOK_SHOW_FEED=0
